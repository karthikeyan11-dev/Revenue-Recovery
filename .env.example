# ==============================================================================
# AI Revenue Recovery Orchestrator — Environment Configuration
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL)
# ------------------------------------------------------------------------------
# For local non-docker dev: postgresql://postgres:postgres@localhost:5433/revenue_recovery
# For docker-compose: postgresql://postgres:postgres@postgres:5432/revenue_recovery
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/revenue_recovery

# PostgreSQL Docker Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=revenue_recovery
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# Multi-Provider LLM Settings
# ------------------------------------------------------------------------------
# Supported providers: anthropic, openai, google, mock
LLM_PROVIDER=anthropic

# Model identifier for reasoning tasks
# Examples:
#   For Anthropic: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
#   For OpenAI:    gpt-4o-mini, gpt-4o
#   For Google:    gemini-1.5-flash, gemini-2.0-flash
#   For Mock:      mock-model
MODEL=claude-3-5-sonnet-20241022

# Provider API Keys (only the key matching the active LLM_PROVIDER is required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ------------------------------------------------------------------------------
# Application & Logging Settings
# ------------------------------------------------------------------------------
# Options: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins for the backend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ChromaDB Vector Store Persistence Directory
CHROMA_PERSIST_DIR=data/chroma_db

# ------------------------------------------------------------------------------
# Frontend Settings
# ------------------------------------------------------------------------------
# Base URL for the frontend to reach the backend REST API
VITE_API_BASE_URL=http://localhost:8000
