# ==============================================================================
# AI Revenue Recovery Orchestrator — Environment Configuration
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL)
# ------------------------------------------------------------------------------
# For local non-docker dev: postgresql://postgres:postgres@localhost:5432/revenue_recovery
# For docker-compose: postgresql://postgres:postgres@postgres:5432/revenue_recovery
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revenue_recovery

# PostgreSQL Docker Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=revenue_recovery
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# LLM Provider & Model Settings
# ------------------------------------------------------------------------------
# Supported providers: anthropic, openai (behind provider abstraction)
LLM_PROVIDER=anthropic

# API key for the LLM reasoning agent layers (Detective, Intel, Strategist, Analyst)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model identifier for reasoning tasks
MODEL=claude-sonnet-4-6

# ------------------------------------------------------------------------------
# Application & Logging Settings
# ------------------------------------------------------------------------------
# Options: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins for the backend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend Settings
# ------------------------------------------------------------------------------
# Base URL for the frontend to reach the backend REST API
VITE_API_BASE_URL=http://localhost:8000
