# Database Settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/revenue_recovery

# Multi-Provider LLM Configuration
# Selectable via LLM_PROVIDER: 'openrouter', 'google', 'anthropic', 'openai', or 'mock'
LLM_PROVIDER=openrouter
MODEL=google/gemini-2.0-flash-001

# Provider API Keys
# Option A: OpenRouter Unified API (Access to 300+ models via 1 key)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option B: Direct Provider API Keys (if using direct provider selection)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Razorpay Test Mode Credentials (Optional - graceful offline fallback if empty)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# App Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
