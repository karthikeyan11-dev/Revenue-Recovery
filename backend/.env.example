# ==============================================================================
# AI Revenue Recovery Orchestrator — Backend Environment Template (.env.example)
# ==============================================================================
# Copy this file to create your local environment:
#   cp backend/.env.example backend/.env
#
# ------------------------------------------------------------------------------
# 📌 CONFIGURATION REQUIREMENTS SUMMARY:
#
# 1. [COMPULSORY REQUIRED TO RUN BACKEND]:
#    - DATABASE_URL: PostgreSQL database connection string.
#    - POSTGRES_*: Database service credentials and port (used by Docker Compose).
#    - LLM_PROVIDER: Must be set. Pre-configured as 'mock' (no API key needed).
#    - MODEL: Model identifier used for reasoning tasks.
#
# 2. [PRE-CONFIGURED FOR INSTANT EXECUTION (Matches backend/.env)]:
#    - Razorpay Sandbox Test Credentials (already filled in for testing).
#    - CORS Origins, Environment, Logging, and Base URLs.
#
# 3. [OPTIONAL — ONLY IF SWITCHING AWAY FROM MOCK]:
#    - OPENROUTER_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY / GOOGLE_API_KEY
#    - If LLM_PROVIDER=mock (default), NO API KEYS ARE REQUIRED.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection Settings [COMPULSORY REQUIRED]
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/revenue_recovery

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=revenue_recovery
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# 2. Multi-Provider LLM Configuration [COMPULSORY REQUIRED]
# ------------------------------------------------------------------------------
# Selectable via LLM_PROVIDER: 'mock' (Recommended for evaluation), 'openrouter', 'google', 'anthropic', or 'openai'
# Default is 'mock' for instant, zero-latency, 100% reliable evaluation without API key dependencies.
LLM_PROVIDER=mock
MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ------------------------------------------------------------------------------
# 3. External Provider API Keys [OPTIONAL — Only needed if LLM_PROVIDER != mock]
# ------------------------------------------------------------------------------
# Option A: OpenRouter Unified API (Access to 300+ models via 1 key)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option B: Direct Provider API Keys (if using direct provider selection)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ------------------------------------------------------------------------------
# 4. Razorpay Test Mode Credentials [PRE-CONFIGURED — Matches backend/.env]
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_TT3JplyhzzZNNn
RAZORPAY_KEY_SECRET=8JSPu36GH3Iv7eiqplFbtLrG
RAZORPAY_WEBHOOK_SECRET=RzPay_RevenueRecovery_Webhook_2026!v7K9!pL4@xN8Q2mT6

# ------------------------------------------------------------------------------
# 5. Application Runtime & Networking Settings [PRE-CONFIGURED]
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

VITE_API_BASE_URL=http://localhost:8000

